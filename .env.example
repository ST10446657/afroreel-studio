# Application and scheduler
AFROREEL_STUDIO_URL=https://your-deployment.example
STUDIO_AUTOMATION_KEY=replace-with-a-long-random-secret
SITES_BYPASS_TOKEN=

# Meta Graph API
META_GRAPH_VERSION=v21.0
META_SHARED_SYSTEM_USER_TOKEN=

# Configure the Page and Instagram account IDs for every workspace.
# Prefixes used by the app: META_EN, META (Zulu), META_HA, META_SW, META_FR.
META_EN_PAGE_ID=
META_EN_IG_USER_ID=
META_EN_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_SYSTEM_USER_TOKEN=
META_HA_PAGE_ID=
META_HA_IG_USER_ID=
META_HA_SYSTEM_USER_TOKEN=
META_SW_PAGE_ID=
META_SW_IG_USER_ID=
META_SW_SYSTEM_USER_TOKEN=
META_FR_PAGE_ID=
META_FR_IG_USER_ID=
META_FR_SYSTEM_USER_TOKEN=

# Zernio credentials, one per language workspace
ZERNIO_EN_API_KEY=
ZERNIO_ZU_API_KEY=
ZERNIO_HA_API_KEY=
ZERNIO_SW_API_KEY=
ZERNIO_FR_API_KEY=

# Post-production
ELEVENLABS_API_KEY=

# Website funnel analytics
LOVABLE_ANALYTICS_URL=
LOVABLE_ANALYTICS_API_KEY=

# Cloudflare D1 is configured as the DB binding in the deployment environment.
